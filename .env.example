# Solo placeholders. Copia a .env (ignorado por git) y llena.
# ─── Meta WhatsApp Cloud API ───────────────────────────────
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=tu_phone_number_id_aqui
WHATSAPP_BUSINESS_ACCOUNT_ID=tu_business_account_id_aqui
WHATSAPP_API_VERSION=v23.0
# Lo inventas tu; debe coincidir con el configurado en Meta.
WEBHOOK_VERIFY_TOKEN=inventa-un-token-aqui
# true = no llama a Meta: los mensajes salientes se registran en consola y en la tabla OutboundMessage.
WHATSAPP_DRY_RUN=true

# ─── Infra ─────────────────────────────────────────────────
DATABASE_URL=postgresql://quientiene:quientiene@localhost:5432/quientiene
REDIS_URL=redis://localhost:6379

# ─── Lectura de recetas: mock | gemini | meta ──────────────
RECIPE_PROVIDER=mock
# Meta Model API (imagen y razonamiento: UNVERIFIED, ver docs/MANANA.md)
MODEL_API_KEY=
# (META_API_KEY se acepta como alias de MODEL_API_KEY)
# dev.meta.ai es el portal, NO la API.
META_API_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.1
# chat = image_url en /chat/completions | responses = input_image en /responses (UNVERIFIED)
META_IMAGE_MODE=chat
# Opcional, para bajar latencia (UNVERIFIED). Vacio = no se envia.
META_REASONING_EFFORT=
# Gemini (prototipo del DevFest)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# ─── Servidor ──────────────────────────────────────────────
PORT=8080
HOST=0.0.0.0
# Telefonos que hacen de farmacia en el demo (E.164, falsos aqui)
FARMACIAS_DEMO=593980000001,593980000002,593980000003
USAR_PLANTILLA=true
NOMBRE_PLANTILLA=consulta_stock_farmacia
IDIOMA_PLANTILLA=es
