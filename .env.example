# ─── Meta WhatsApp Cloud API ───────────────────────────────
# developers.facebook.com -> QuienTiene Bot -> WhatsApp -> Configuracion de la API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=tu_phone_number_id_aqui
WHATSAPP_BUSINESS_ACCOUNT_ID=tu_business_account_id_aqui
WHATSAPP_API_VERSION=v23.0

# Lo inventas tu. Tiene que coincidir con lo que pongas en Meta al configurar el webhook.
WEBHOOK_VERIFY_TOKEN=inventa-un-token-aqui

# ─── Google Gemini ─────────────────────────────────────────
# aistudio.google.com/apikey
GEMINI_API_KEY=

# ─── Google Maps Platform ──────────────────────────────────
# console.cloud.google.com -> APIs -> habilitar "Distance Matrix API"
MAPS_API_KEY=

# ─── Servidor ──────────────────────────────────────────────
PORT=8080
HOST=0.0.0.0

# Numeros que hacen de farmacia en el demo (E.164, separados por coma)
# Deben estar agregados como destinatarios de prueba en Meta.
FARMACIAS_DEMO=593980000001,593980000002,593980000003

# Si la plantilla de Meta aun no esta aprobada, pon false y el bot
# usara mensajes libres dentro de la ventana de 24h (plan B).
USAR_PLANTILLA=true
NOMBRE_PLANTILLA=consulta_stock_farmacia
IDIOMA_PLANTILLA=es
