{
  "name": "quien-tiene",
  "version": "0.1.0",
  "description": "Buscador de disponibilidad de medicinas en farmacias del Ecuador, por WhatsApp",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "worker": "tsx src/worker.ts",
    "worker:prod": "node dist/src/worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:migrar": "prisma migrate deploy",
    "db:sembrar": "tsx scripts/sembrar.ts",
    "probar:ia": "tsx scripts/probar-ia.ts",
    "simular": "tsx scripts/simular-flujo.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bullmq": "^6.6.0",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "ioredis": "^6.0.0",
    "prisma": "^6.19.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vitest": "^5.1.0"
  }
}
